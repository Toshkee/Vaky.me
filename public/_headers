# Cloudflare Pages reads this file from the root of the build output. Next
# copies everything in public/ into out/ verbatim, so this lands where Pages
# looks for it.
#
# This is the only place response headers are set for vaky.me. There
# used to be a second copy in `vercel.json`, back when a Vercel project built
# this repo in parallel; that project is gone and so is the file, so nothing
# here needs mirroring anywhere. The CSP is explained in
# docs/deployment-security.md — read that before loosening a directive.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' mailto:; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://cloud.umami.is https://static.cloudflareinsights.com; script-src-attr 'none'; connect-src 'self' https://cloud.umami.is https://gateway.umami.is https://cloudflareinsights.com; frame-src https://www.google.com https://challenges.cloudflare.com; upgrade-insecure-requests
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # Pages sends `Access-Control-Allow-Origin: *` by default. Nothing here is
  # meant to be read cross-origin, so it is narrowed to this site rather than
  # left open.
  Access-Control-Allow-Origin: https://vaky.me
