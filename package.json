{
  "name": "vibelab.me",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "dev:api": "wrangler pages dev out --d1=DB=vibelab-onboarding --r2=UPLOADS --compatibility-date=2026-08-30",
    "build:functions": "wrangler pages functions build --outdir .wrangler/functions-build",
    "check:mobile": "node scripts/mobile-check.mjs",
    "test:security": "node scripts/security-check.mjs",
    "check:a11y": "node scripts/a11y-check.mjs",
    "test:workflow": "node scripts/workflow-check.mjs",
    "shots:visual": "node scripts/visual-shots.mjs",
    "shots:mobile": "node scripts/mobile-shots.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  }
}
