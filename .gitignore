# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# lighthouse ci reports
.lighthouseci/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# prospect research - contact data, never publish
/research

# scratch: screenshots, one-off probes, throwaway servers. Kept on disk
# because it is useful while working, out of the repository because it is
# nobody else's and it was 40 MB of it.
/.tmp

# cloudflare: local worker state (the dev D1 database and R2 objects), and the
# secrets `wrangler pages dev` reads. Production values live in the Cloudflare
# dashboard - see docs/onboarding-setup.md.
/.wrangler
.dev.vars
.dev.vars.*
!.dev.vars.example
