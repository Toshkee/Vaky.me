# Public build-time variables for `next build`. Copy to `.env.local` (gitignored)
# or set them on the Cloudflare Pages project. Every value here ends up in the
# exported HTML, so nothing secret belongs in this file — provider secrets go
# in `.dev.vars` locally and in the Pages dashboard in production.
#
# Unset means off: the feature's script is never requested and the exported
# HTML carries no reference to it. See src/config/services.ts.

# Umami page analytics. The website id switches it on; the script URL only
# needs setting for a self-hosted Umami.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Cloudflare Web Analytics is enabled in the Cloudflare dashboard, not here.
# Set to `on` only so the CSP admits its beacon; clear it when it is turned off.
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS=

# Turnstile site key for the lead form. Does nothing until the matching
# TURNSTILE_SECRET_KEY exists on the Functions side (see .dev.vars.example).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
